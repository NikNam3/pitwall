{
  "name": "pitwall",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "pretypecheck": "pnpm gen",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @pitwall/ui check",
    "pretest": "pnpm gen",
    "test": "vitest run",
    "pretest:acceptance": "pnpm gen",
    "test:acceptance": "vitest run -c vitest.acceptance.config.ts",
    "lint": "eslint .",
    "depcruise": "depcruise packages apps test-support test --config .dependency-cruiser.cjs",
    "mutation": "pnpm --workspace-concurrency=1 --filter @pitwall/protocol --filter @pitwall/engine --filter @pitwall/strategy run mutation",
    "check": "pnpm typecheck && pnpm lint && pnpm depcruise && pnpm test",
    "gen:features": "node scripts/gen-features.ts",
    "gen:topics": "node scripts/gen-topics.ts",
    "gen:widgets": "node scripts/gen-widgets.ts",
    "gen:catalogue": "node scripts/gen-catalogue.ts",
    "gen": "pnpm gen:features && pnpm gen:topics && pnpm gen:widgets && pnpm gen:catalogue",
    "ui:dev": "pnpm --filter @pitwall/ui dev",
    "ui:build": "pnpm --filter @pitwall/ui build",
    "pitwall": "pnpm -s gen:features && pnpm -s gen:topics && pnpm -s gen:widgets && node scripts/gen-catalogue.ts --no-fail && node apps/bridge/src/cli/pitwall.ts",
    "pwrec-cut": "node apps/bridge/src/cli/pwrec-cut.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "fast-check": "^4.10.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
